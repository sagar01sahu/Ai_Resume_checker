# GEMINI_API_KEY: Optional Gemini API key for enhanced structured extraction and explanations.
# When omitted, the system falls back gracefully to deterministic spaCy/regex rules and template explanations.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
LLM_PROVIDER="gemini"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL connection string (used by Python FastAPI backend in Docker / Render)
DATABASE_URL="postgresql://resume_ranker:resume_ranker@localhost:5432/resume_ranker"

# Sentence-Transformers embedding model bundled in Docker
EMBEDDING_MODEL="all-MiniLM-L6-v2"
